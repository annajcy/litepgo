{
  "name": "litepgo-doc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "corepack pnpm reference && corepack pnpm tutorials && vitepress dev --host 127.0.0.1",
    "build": "corepack pnpm reference && corepack pnpm tutorials && vitepress build",
    "preview": "vitepress preview --host 127.0.0.1",
    "reference:cpp": "uv run --locked --group docs python scripts/cpp_reference.py",
    "reference:python": "uv run --locked --group docs python scripts/python_reference.py",
    "reference": "corepack pnpm reference:cpp && corepack pnpm reference:python",
    "tutorials": "uv run --locked --group docs python scripts/tutorials.py",
    "tutorials:render": "uv run --locked --group docs python scripts/tutorials.py --no-execute"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "mermaid": "11.17.2",
    "vitepress": "1.6.4"
  }
}
